# Persistent sandbox disk. Do not mount Daytona FUSE volumes at these paths.
OUTREACH_DB=/data/outreach/outreach.db
OUTREACH_HOME=/data/outreach
OUTREACH_WORKSPACE=default
OUTREACH_CHROME_PROFILE_DIR=/data/chrome-profiles
OUTREACH_SOCIAL_ACCOUNT_BINDINGS_FILE=/data/outreach/social-bindings.json
OUTREACH_BROWSER_RECIPES_FILE=/data/outreach/browser-recipes.json
OUTREACH_MEDIA_ALLOWED_ORIGINS=[]
OUTREACH_PORT=8787
OUTREACH_LIVE_VIEW_PORT=6080
OUTREACH_BACKUP_EVERY_HOURS=24
# The controller writes the actual sandbox ID and never prints engine/preview credentials.
DAYTONA_SANDBOX_ID=
# API OAuth grants may be placed in private files inside /data/outreach and referenced with file:.
